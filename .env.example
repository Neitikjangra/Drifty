# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
# Platform Chat API host for your app's data center, e.g. api.sg-light-api.com (Singapore),
# api.us-light-api.com (North America). Defaults to Singapore if empty.
NEXCONN_API_BASE=
# Not needed: Nexconn signs webhooks with the App Secret (sha1(AppSecret+Nonce+Timestamp)).
NEXCONN_WEBHOOK_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
AI_MODEL=gemini-3.8-flash
SENTRY_DSN=
MAGIC_LINK_SIGNING_SECRET=
# Round 0 only: set to 1 to enable the /spike test page and its API routes.
SPIKE_ENABLED=
