# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
# Platform Chat API host for your app's data center, e.g. api.sg-light-api.com (Singapore),
# api.us-light-api.com (North America). Defaults to Singapore if empty.
NEXCONN_API_BASE=
# Not needed: Nexconn signs webhooks with the App Secret (sha1(AppSecret+Nonce+Timestamp)).
NEXCONN_WEBHOOK_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
AI_MODEL=gemini-3.8-flash
SENTRY_DSN=
MAGIC_LINK_SIGNING_SECRET=
# Postgres connection string for applying migrations (server/CLI only, never deployed)
SUPABASE_DB_URL=
# true = show "Email me a code instead" and emailed password reset (needs working SMTP in Supabase)
EMAIL_ENABLED=
# Shown on the login page as the address to contact for password resets
SUPPORT_EMAIL=
# Optional second Gemini model, used only when AI_MODEL is overloaded (503/429/timeout). Empty = off.
AI_FALLBACK_MODEL=

# Vercel Cron: protects /api/cron/daily (nudges + daily digest). Any long random string.
CRON_SECRET=
