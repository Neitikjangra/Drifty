{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "drifty-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 3000
    },
    {
      "name": "drifty-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["start", "-p", "3100"],
      "port": 3100
    },
    {
      "name": "drifty-prod-ai-fallback",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set AI_FALLBACK_MODEL=gemini-3-flash-preview&& pnpm start -p 3101"],
      "port": 3101
    }
  ]
}
